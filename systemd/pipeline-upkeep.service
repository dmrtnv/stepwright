[Unit]
Description=Pipeline upkeep: sweep deferred items, archive, gc
After=sbx.service

[Service]
Type=oneshot
TimeoutStartSec=1h
# Must reach node and claude: add the directories of `command -v node` and `command -v claude` if they are elsewhere.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/pipeline upkeep
