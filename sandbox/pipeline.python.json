{
  "base": "main",
  "setup": ["pip3 install --user --break-system-packages -r requirements.txt"],
  "setupEgress": ["pypi.org", "files.pythonhosted.org"],
  "checkFast": [
    {"name": "test", "run": "python3 -m unittest discover tests"}
  ],
  "protected": [".github/**", ".claude/**", "requirements.txt"],
  "ci": {"requiredChecks": ["test"]}
}
